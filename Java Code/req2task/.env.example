# ─────────────────────────────────────────────────────────────────────────────
# req2task — Example Environment Configuration
#
# Copy this file to .env and fill in your keys:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# Active AI provider: ollama | openai | anthropic
AI_PROVIDER=ollama

# ── 1. Groq (100% FREE, NO Credit Card, Super Fast ~1s) ───────────────────────
# Get free key in 30 seconds at: https://console.groq.com/keys
# To use: set AI_PROVIDER=openai and uncomment the 3 lines below:
# OPENAI_BASE_URL=https://api.groq.com/openai
# OPENAI_API_KEY=gsk_your_groq_key_here
# OPENAI_MODEL=llama-3.3-70b-versatile

# ── 2. Google Gemini (100% FREE, NO Credit Card) ──────────────────────────────
# Get free key at: https://aistudio.google.com/apikey
# To use: set AI_PROVIDER=openai and uncomment the 3 lines below:
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_API_KEY=AIzaSy_your_gemini_key_here
# OPENAI_MODEL=gemini-2.0-flash

# ── 3. Official OpenAI (Paid) ─────────────────────────────────────────────────
# Get key: https://platform.openai.com/api-keys
OPENAI_BASE_URL=https://api.openai.com
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# ── 4. Anthropic Claude (Paid) ────────────────────────────────────────────────
# Get key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ── 5. Ollama (100% Local, Free, Offline) ─────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080
